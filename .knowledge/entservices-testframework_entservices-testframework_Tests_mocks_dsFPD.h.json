{"is_source_file": true, "format": "C Header File", "description": "This file defines the interface for the Front Panel Display (FPD) Hardware Abstraction Layer (HAL) in a device settings context. It includes enumerations for indicators, LED states, display states, and function prototypes for initializing, configuring, and terminating the FPD subsystem, as well as setting LED behavior such as blinking, brightness, color, and power states. The file also contains deprecated functions related to 7-segment display configurations.", "external_files": ["devicesettings.h"], "external_methods": [], "published": ["dsFPDIndicator_t", "dsFPDLedState_t", "dsFPDState_t", "dsFPDMode_t", "dsFPDTimeFormat_t", "dsError_t", "dsFPDApi", "dsFPDColor_t", "dsFPDTextDisplay_t"], "classes": [{"name": "dsFPDImpl", "description": "Abstract base class defining the interface for the Front Panel Display HAL implementation. It declares virtual methods for initialization, configuration, retrieval, and termination operations related to front panel display indicators and states."}, {"name": "dsFPDApi", "description": "API class providing static methods to interact with the Front Panel Display HAL implementation via a singleton pattern. It delegates calls to a static implementation pointer 'impl'."}], "methods": [{"name": "dsFPInit", "description": "Initializes the Front Panel Display sub-module, allocating resources and preparing the hardware interface."}, {"name": "dsSetFPBlink", "description": "Sets the blink pattern (duration and iterations) for a specified LED indicator."}, {"name": "dsSetFPBrightness", "description": "Sets the brightness level (0-100) of a specified LED indicator."}, {"name": "dsGetFPBrightness", "description": "Retrieves the current brightness level of a specified LED indicator."}, {"name": "dsSetFPState", "description": "Sets the operational state (e.g., on, off, standby) of a specified indicator."}, {"name": "dsGetFPState", "description": "Gets the current operational state of a specified indicator."}, {"name": "dsSetFPColor", "description": "Sets the color of an indicator that supports multiple colors."}, {"name": "dsGetFPColor", "description": "Retrieves the current color of an indicator that supports multiple colors."}, {"name": "dsFPTerm", "description": "Terminates the FPD module, releasing resources."}, {"name": "dsFPGetLEDState", "description": "Gets the current power LED state."}, {"name": "dsFPSetLEDState", "description": "Sets the power LED to a specified state."}, {"name": "dsFPGetSupportedLEDStates", "description": "Retrieves the supported LED states bitwise mask."}], "calls": ["dsFPInit", "dsSetFPBlink", "dsSetFPBrightness", "dsGetFPBrightness", "dsSetFPState", "dsGetFPState", "dsSetFPColor", "dsGetFPColor", "dsFPTerm", "dsFPGetLEDState", "dsFPSetLEDState", "dsFPGetSupportedLEDStates"], "search-terms": ["FrontPanelDisplay", "LED indicator", "PWM Brightness", "Hardware Abstraction Layer", "Device Settings HAL", "LED color control", "Display State", "Deprecated 7-Segment APIs", "LED blinking pattern"], "state": 2, "file_id": 9098, "knowledge_revision": 18231, "git_revision": "", "ctags": [{"_type": "tag", "name": "__DS_FPD_H__", "path": "/home/kavia/workspace/code-generation/app-gateway2/entservices-testframework/entservices-testframework/Tests/mocks/dsFPD.h", "pattern": "/^#define __DS_FPD_H__$/", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "__dsFPDIndicator_t", "path": "/home/kavia/workspace/code-generation/app-gateway2/entservices-testframework/entservices-testframework/Tests/mocks/dsFPD.h", "pattern": "/^typedef enum __dsFPDIndicator_t$/", "language": "C++", "kind": "enum"}, {"_type": "tag", "name": "__dsFPDLedState_t", "path": "/home/kavia/workspace/code-generation/app-gateway2/entservices-testframework/entservices-testframework/Tests/mocks/dsFPD.h", "pattern": "/^typedef enum __dsFPDLedState_t$/", "language": "C++", "kind": "enum"}, {"_type": "tag", "name": "__dsFPDState_t", "path": "/home/kavia/work